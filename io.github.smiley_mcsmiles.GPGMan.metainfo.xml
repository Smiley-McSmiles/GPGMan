<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.smiley_mcsmiles.GPGMan</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>GPGMan</name>
  <summary>OpenPGP and GnuPG key manager</summary>
  <developer id="io.github.smiley_mcsmiles">
    <name>WOOSAH</name>
  </developer>
  <description>
    <p>GPGMan manages GPG keys and performs OpenPGP operations from a modern GTK4 desktop interface or an equivalent terminal CLI.</p>
    <ul>
      <li>Create, import, export and delete keys, including drag-and-drop key import</li>
      <li>Encrypt and decrypt messages and files</li>
      <li>Sign and verify text and files</li>
    </ul>
  </description>
  <branding>
    <color type="primary" scheme_preference="light">#f6d26b</color>
    <color type="primary" scheme_preference="dark">#1c3a5e</color>
  </branding>
  <!-- TODO (required by Flathub): add at least one real screenshot hosted at a stable URL, e.g.
  <screenshots>
    <screenshot type="default">
      <caption>Managing keys in GPGMan</caption>
      <image type="source">https://raw.githubusercontent.com/Smiley-McSmiles/GPGMan/main/screenshots/keys.png</image>
    </screenshot>
  </screenshots>
  -->
  <launchable type="desktop-id">io.github.smiley_mcsmiles.GPGMan.desktop</launchable>
  <url type="homepage">https://github.com/Smiley-McSmiles/GPGMan</url>
  <url type="vcs-browser">https://github.com/Smiley-McSmiles/GPGMan</url>
  <url type="bugtracker">https://github.com/Smiley-McSmiles/GPGMan/issues</url>
  <provides>
    <binary>gpgman</binary>
    <mediatype>application/pgp-keys</mediatype>
    <mediatype>application/pgp-encrypted</mediatype>
    <mediatype>application/pgp-signature</mediatype>
  </provides>
  <categories>
    <category>Utility</category>
    <category>Security</category>
  </categories>
  <content_rating type="oars-1.1" />
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <releases>
    <release version="1.3.4" date="2026-10-04">
      <description>
        <ul>
          <li>Flatpak: file dialogs use the file chooser portal, so the app no longer needs access to all files</li>
          <li>Application ID changed to io.github.smiley_mcsmiles.GPGMan</li>
          <li>Passphrases are no longer visible in the process list while gpg runs</li>
          <li>Exported secret keys are saved readable by the owner only</li>
          <li>Key downloads from a URL are limited to a sane size</li>
          <li>Cached passphrases are cleared from gpg-agent when GPGMan quits, or from the System tab</li>
        </ul>
      </description>
    </release>
    <release version="1.3.3" date="2026-10-04">
      <description>
        <ul>
          <li>Import keys by dragging and dropping key files onto the Keys view</li>
          <li>Open .asc files from your file manager to import keys, decrypt messages or verify signatures</li>
          <li>Secret key export now prompts for the passphrase on any desktop environment</li>
          <li>Fixed the application icon and name in the dock</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
